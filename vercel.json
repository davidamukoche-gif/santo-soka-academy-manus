{
  "buildCommand": "pnpm build:frontend",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/reset-password", "destination": "/admin/reset-password.html" },
    { "source": "/admin/dashboard", "destination": "/manage-senior-players.html" }
  ]
}
